<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:message id="Msg_JD" name="Job description received" />
<bpmn:message id="Msg_Draft" name="Draft proposal received" />
<bpmn:message id="Msg_Decision" name="Review decision received" />
<bpmn:message id="Msg_Final" name="Final proposal received" />
<bpmn:collaboration id="Collab_1">
<bpmn:participant id="Pool_Engine" name="Proposal Engine (n8n)" processRef="Process_Engine" />
<bpmn:participant id="Pool_Castro" name="Castro (Freelancer)" processRef="Process_Castro" />
<bpmn:messageFlow id="m1" sourceRef="C_send1" targetRef="S1" />
<bpmn:messageFlow id="m2" sourceRef="T_post" targetRef="C_draft" />
<bpmn:messageFlow id="m3" sourceRef="C_senddec" targetRef="C_dec" />
<bpmn:messageFlow id="m4" sourceRef="T_final" targetRef="C_final" />
</bpmn:collaboration>
<bpmn:process id="Process_Engine" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="Lane_Archive" name="Archive (Notion)"><bpmn:flowNodeRef>T_notion</bpmn:flowNodeRef><bpmn:flowNodeRef>T_update</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_AI" name="AI Analysis"><bpmn:flowNodeRef>T_A</bpmn:flowNodeRef><bpmn:flowNodeRef>T_B</bpmn:flowNodeRef><bpmn:flowNodeRef>T_C</bpmn:flowNodeRef><bpmn:flowNodeRef>T_D</bpmn:flowNodeRef><bpmn:flowNodeRef>G_pass</bpmn:flowNodeRef><bpmn:flowNodeRef>T_rev</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Intake" name="Intake"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>T_norm</bpmn:flowNodeRef><bpmn:flowNodeRef>G_info</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Deliv" name="Delivery (Slack)"><bpmn:flowNodeRef>T_ask</bpmn:flowNodeRef><bpmn:flowNodeRef>E_ask</bpmn:flowNodeRef><bpmn:flowNodeRef>T_post</bpmn:flowNodeRef><bpmn:flowNodeRef>G_appr</bpmn:flowNodeRef><bpmn:flowNodeRef>T_final</bpmn:flowNodeRef><bpmn:flowNodeRef>E_done</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S1" name="Job description received"><bpmn:documentation>n8n: Slack Trigger (new message in #proposals) + IF node to ignore bot messages.</bpmn:documentation><bpmn:outgoing>f1</bpmn:outgoing><bpmn:messageEventDefinition id="S1_med" messageRef="Msg_JD" /></bpmn:startEvent>
<bpmn:serviceTask id="T_norm" name="Normalize input"><bpmn:documentation>n8n: Set/Code node, or LLM call with Structured Output Parser. Extract title, budget, skills, scope.</bpmn:documentation><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G_info" name="Enough information?"><bpmn:documentation>n8n: IF node.</bpmn:documentation><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing><bpmn:outgoing>f5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="T_ask" name="Ask for missing details"><bpmn:documentation>n8n: Slack &gt; Send Message (in thread).</bpmn:documentation><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="E_ask" name="Run stopped: details requested"><bpmn:incoming>f4</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="T_notion" name="Create Notion record"><bpmn:documentation>n8n: Notion &gt; Create Database Page. Status = Received.</bpmn:documentation><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="T_A" name="Define problem"><bpmn:documentation>Bulletproof Problem Solving steps 1-3 (problem definition, disaggregation, prioritization). n8n: Basic LLM Chain (Anthropic or Gemini Chat Model) + Structured Output Parser. Output JSON: problem statement, issue tree, priorities.</bpmn:documentation><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="T_B" name="Infer As-Is process"><bpmn:documentation>Fundamentals of BPM: process, pain points, root causes, value-added analysis, Devil's quadrangle (time, cost, quality, flexibility). n8n: Basic LLM Chain (Anthropic or Gemini Chat Model) + Structured Output Parser. Output JSON.</bpmn:documentation><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="T_C" name="Write pyramid proposal"><bpmn:documentation>Bulletproof steps 6-7 (synthesis, communication). Governing thought first, SCQA opener, 3 MECE arguments, each with a fact quoted from the job description, a solution point and client benefit. Then tool stack and first-week approach.</bpmn:documentation><bpmn:incoming>f8</bpmn:incoming><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="T_D" name="Critique proposal"><bpmn:documentation>Critic LLM call scoring against checklist: every fact traces to the job description, inferences labelled as hypotheses, MECE arguments, length.</bpmn:documentation><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G_pass" name="Passes checks?"><bpmn:documentation>n8n: IF node with a loop counter (max 2 revisions).</bpmn:documentation><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="T_post" name="Post draft to Slack"><bpmn:documentation>n8n: Slack &gt; Send Message with Approve / Request changes buttons.</bpmn:documentation><bpmn:incoming>f12</bpmn:incoming><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="G_appr" name="Approved?"><bpmn:documentation>n8n: IF node.</bpmn:documentation><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing><bpmn:outgoing>f17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T_rev" name="Revise draft with feedback"><bpmn:documentation>n8n: Basic LLM Chain with the reviewer feedback as input.</bpmn:documentation><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="T_update" name="Update Notion: Reviewed"><bpmn:documentation>n8n: Notion &gt; Update Page and Append Blocks (split text into blocks under 2,000 characters).</bpmn:documentation><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sendTask id="T_final" name="Post final proposal to Slack"><bpmn:documentation>n8n: Slack &gt; Send Message in the original thread.</bpmn:documentation><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="E_done" name="Proposal delivered"><bpmn:incoming>f19</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="S1" targetRef="T_norm" />
<bpmn:sequenceFlow id="f2" sourceRef="T_norm" targetRef="G_info" />
<bpmn:sequenceFlow id="f3" sourceRef="G_info" targetRef="T_ask" name="No" />
<bpmn:sequenceFlow id="f4" sourceRef="T_ask" targetRef="E_ask" />
<bpmn:sequenceFlow id="f5" sourceRef="G_info" targetRef="T_notion" name="Yes" />
<bpmn:sequenceFlow id="f6" sourceRef="T_notion" targetRef="T_A" />
<bpmn:sequenceFlow id="f7" sourceRef="T_A" targetRef="T_B" />
<bpmn:sequenceFlow id="f8" sourceRef="T_B" targetRef="T_C" />
<bpmn:sequenceFlow id="f9" sourceRef="T_C" targetRef="T_D" />
<bpmn:sequenceFlow id="f10" sourceRef="T_D" targetRef="G_pass" />
<bpmn:sequenceFlow id="f11" sourceRef="G_pass" targetRef="T_C" name="No (max 2 loops)" />
<bpmn:sequenceFlow id="f12" sourceRef="G_pass" targetRef="T_post" name="Yes" />
<bpmn:sequenceFlow id="f13" sourceRef="T_post" targetRef="C_dec" />
<bpmn:sequenceFlow id="f14" sourceRef="C_dec" targetRef="G_appr" />
<bpmn:sequenceFlow id="f15" sourceRef="G_appr" targetRef="T_rev" name="No" />
<bpmn:sequenceFlow id="f16" sourceRef="T_rev" targetRef="T_post" />
<bpmn:sequenceFlow id="f17" sourceRef="G_appr" targetRef="T_update" name="Yes" />
<bpmn:sequenceFlow id="f18" sourceRef="T_update" targetRef="T_final" />
<bpmn:sequenceFlow id="f19" sourceRef="T_final" targetRef="E_done" />
<bpmn:textAnnotation id="TA1"><bpmn:text>Error handling: add an error boundary event to each AI task (Define problem to Critique proposal) routing to the n8n Error workflow: Slack alert + Notion status = Failed.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="A1" sourceRef="TA1" targetRef="T_A" />
</bpmn:process>
<bpmn:process id="Process_Castro" isExecutable="false">
<bpmn:intermediateCatchEvent id="C_dec" name="Review decision received"><bpmn:documentation>n8n: Wait node (resume on webhook from Slack interactivity).</bpmn:documentation><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing><bpmn:messageEventDefinition id="C_dec_med" messageRef="Msg_Decision" /></bpmn:intermediateCatchEvent>
<bpmn:startEvent id="C_start" name="Job description found on Upwork"><bpmn:outgoing>c1</bpmn:outgoing></bpmn:startEvent>
<bpmn:sendTask id="C_send1" name="Post job description to Slack"><bpmn:incoming>c1</bpmn:incoming><bpmn:outgoing>c2</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="C_draft" name="Draft proposal received"><bpmn:incoming>c2</bpmn:incoming><bpmn:outgoing>c3</bpmn:outgoing><bpmn:messageEventDefinition id="C_draft_med" messageRef="Msg_Draft" /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="C_review" name="Review draft"><bpmn:incoming>c3</bpmn:incoming><bpmn:outgoing>c4</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="C_senddec" name="Send decision (approve or request changes)"><bpmn:incoming>c4</bpmn:incoming><bpmn:outgoing>c5</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="C_final" name="Final proposal received"><bpmn:incoming>c5</bpmn:incoming><bpmn:outgoing>c6</bpmn:outgoing><bpmn:messageEventDefinition id="C_final_med" messageRef="Msg_Final" /></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="C_end" name="Proposal ready to submit on Upwork"><bpmn:incoming>c6</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="c1" sourceRef="C_start" targetRef="C_send1" />
<bpmn:sequenceFlow id="c2" sourceRef="C_send1" targetRef="C_draft" />
<bpmn:sequenceFlow id="c3" sourceRef="C_draft" targetRef="C_review" />
<bpmn:sequenceFlow id="c4" sourceRef="C_review" targetRef="C_senddec" />
<bpmn:sequenceFlow id="c5" sourceRef="C_senddec" targetRef="C_final" />
<bpmn:sequenceFlow id="c6" sourceRef="C_final" targetRef="C_end" />
</bpmn:process>
